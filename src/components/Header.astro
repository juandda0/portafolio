---
import { content } from '../data/content';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/' : '/en/';
---

<header class="header">
  <div class="container inner">
    <a href={home} class="brand">{profile.shortName}</a>
    <nav aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
      <a href="#experiencia">{t.nav.experience}</a>
      <a href="#proyectos">{t.nav.projects}</a>
      <a href="#logros">{t.nav.awards}</a>
      <a href="#contacto">{t.nav.contact}</a>
      <a
        href={t.switchLang.href}
        class="lang"
        hreflang={lang === 'es' ? 'en' : 'es'}
        aria-label={lang === 'es' ? 'View in English' : 'Ver en español'}>{t.switchLang.label}</a
      >
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }
  .brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.5vw, 28px);
    font-size: 0.875rem;
  }
  nav a {
    color: var(--muted);
    transition: color 0.15s;
  }
  nav a:hover {
    color: var(--text);
  }
  .lang {
    font-family: var(--mono);
    font-size: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 9px;
  }
  @media (max-width: 640px) {
    nav a:not(.lang):not([href='#contacto']) {
      display: none;
    }
  }
</style>
