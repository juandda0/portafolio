---
interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'download' | 'arrow' | 'copy' | 'close' | 'sound' | 'prev' | 'next';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
    )
  }
  {name === 'download' && <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" />}
  {name === 'arrow' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'copy' && <><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h8" /></>}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'prev' && <path d="m15 6-6 6 6 6" />}
  {name === 'next' && <path d="m9 6 6 6-6 6" />}
  {name === 'sound' && <><path d="M11 5 6 9H3v6h3l5 4z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></>}
</svg>
