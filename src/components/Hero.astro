---
import Icon from './Icon.astro';
import { content } from '../data/content';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="hero container">
  <p class="status"><span class="dot" aria-hidden="true"></span>{t.available}</p>
  <h1>{profile.name}</h1>
  <p class="eyebrow">{t.eyebrow}</p>
  <p class="title">{t.title}</p>
  <p class="pitch">{t.pitch}</p>

  <div class="actions">
    <a class="btn btn-primary" href={`mailto:${profile.email}`}><Icon name="mail" />{profile.email}</a>
    <a class="btn" href={profile.linkedin} target="_blank" rel="noopener me"><Icon name="linkedin" />LinkedIn</a>
    <a class="btn" href={profile.github} target="_blank" rel="noopener me"><Icon name="github" />GitHub</a>
    <a class="btn" href={profile.cv[lang]} download><Icon name="download" />{t.cv}</a>
  </div>

  <dl class="stats">
    {
      t.stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 11vw, 128px) clamp(56px, 8vw, 96px);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent);
  }
  h1 {
    font-size: 1rem;
    font-weight: 500;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 4px;
  }
  .title {
    font-size: clamp(2.25rem, 6.4vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.04;
    max-width: 16ch;
    margin-top: 28px;
    text-wrap: balance;
  }
  .pitch {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    color: var(--muted);
    max-width: 60ch;
    margin-top: 24px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: clamp(28px, 6vw, 72px);
    margin: clamp(48px, 7vw, 72px) 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  dd {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .actions .btn {
      flex: 1 1 calc(50% - 5px);
      justify-content: center;
    }
    .actions .btn-primary {
      flex-basis: 100%;
    }
  }
</style>
