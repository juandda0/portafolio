---
import Icon from './Icon.astro';
import { content } from '../data/content';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;

// El JSON se arma como HTML en una sola cadena: dentro de <pre> cualquier espacio del template se vería.
// Los arrays largos se parten en filas de 3 para que quepa sin scroll horizontal.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const span = (cls: string, text: string) => `<span class="${cls}">${esc(text)}</span>`;
const str = (s: string) => span('s', `"${s}"`);
const json = [
  span('p', '{'),
  ...t.json.map(([key, value], i) => {
    let v: string;
    if (typeof value === 'boolean') v = span('b', String(value));
    else if (Array.isArray(value)) {
      const indent = ' '.repeat(key.length + 7);
      const rows = Array.from({ length: Math.ceil(value.length / 3) }, (_, r) =>
        value.slice(r * 3, r * 3 + 3).map(str).join(span('p', ', ')),
      );
      v = span('p', '[') + rows.join(span('p', ',') + '\n' + indent) + span('p', ']');
    } else v = str(value);
    return `  ${span('k', `"${key}"`)}${span('p', ': ')}${v}${i < t.json.length - 1 ? span('p', ',') : ''}`;
  }),
  span('p', '}'),
].join('\n');
---

<section class="hero">
  <div class="container grid">
    <div>
      <p class="status"><span class="dot" aria-hidden="true"></span>{t.available}</p>
      <h1>Juan Diego <span class="last">Díaz Avendaño</span></h1>
      <p class="role">{t.role} <span class="sep">·</span> <span class="muted">{t.stackline}</span></p>
      <p class="pitch">{t.pitch}</p>

      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}><Icon name="mail" />{profile.email}</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener me"><Icon name="linkedin" />LinkedIn</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener me"><Icon name="github" />GitHub</a>
        <a class="btn" href={profile.cv[lang]} download><Icon name="download" />{t.cv}</a>
      </div>

      <dl class="stats">
        {
          t.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="term" aria-label={lang === 'es' ? 'Resumen en formato JSON' : 'Summary as JSON'}>
      <figcaption class="bar">
        <span class="verb">GET</span><span>/me</span><span class="code">200 OK</span>
      </figcaption>
      <pre><code set:html={json} /></pre>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(56px, 10vw, 120px) clamp(56px, 8vw, 96px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent);
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(2.75rem, 6.6vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  .last {
    display: block;
    color: var(--muted);
  }
  .role {
    margin-top: 22px;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .role .sep {
    color: var(--faint);
    font-weight: 400;
  }
  .role .muted {
    font-weight: 500;
  }
  .pitch {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 58ch;
    margin-top: 14px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: clamp(28px, 6vw, 64px);
    margin: clamp(40px, 6vw, 56px) 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  dd {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .term {
    margin: 0;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 30px 80px -48px rgb(0 0 0 / 0.55);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font: 500 0.8125rem/1 var(--mono);
  }
  .verb {
    color: var(--accent);
  }
  .code {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent);
    border-radius: 5px;
    padding: 4px 8px;
  }
  pre {
    margin: 0;
    padding: 18px 20px 22px;
    overflow-x: auto;
    font: 400 0.8125rem/1.75 var(--mono);
    color: var(--text);
  }
  .k {
    color: var(--accent);
  }
  .b {
    color: var(--ok);
  }
  .p {
    color: var(--faint);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .actions .btn {
      flex: 1 1 calc(50% - 5px);
      justify-content: center;
    }
    .actions .btn-primary {
      flex-basis: 100%;
    }
    pre {
      font-size: 0.6875rem;
      padding: 16px 14px;
    }
  }
</style>
