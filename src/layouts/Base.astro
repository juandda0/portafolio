---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { loadReference } from '../lib/reference';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = {
  es: {
    title: 'Juan Diego Díaz Avendaño · Desarrollador Backend',
    description:
      'Desarrollador backend con Java, Spring Boot, Node.js y PostgreSQL en Montería, Colombia. Experiencia, proyectos, premios, ponencias y contacto.',
  },
  en: {
    title: 'Juan Diego Díaz Avendaño · Backend Developer',
    description:
      'Backend developer working with Java, Spring Boot, Node.js and PostgreSQL, based in Colombia. Experience, projects, awards, talks and contact.',
  },
}[lang];

const { css, markup, script, ogImage } = await loadReference(lang);
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const alternate = (l: Lang) => (site ? new URL(l === 'es' ? '/' : '/en/', site).href : undefined);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: lang === 'es' ? 'Desarrollador Backend' : 'Backend Developer',
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Montería', addressCountry: 'CO' },
  alumniOf: 'Universidad de Córdoba',
  sameAs: [profile.linkedin, profile.github],
};
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0b0b0c" />
    <!-- Oscuro por defecto; si el visitante eligió el claro, se aplica antes de pintar para evitar el destello. -->
    <script is:inline>
      try {
        if (localStorage.getItem('jd-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#fafaf9');
        }
      } catch (e) {}
    </script>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {site && <link rel="alternate" hreflang="es" href={alternate('es')} />}
    {site && <link rel="alternate" hreflang="en" href={alternate('en')} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {site && <meta property="og:image" content={new URL(ogImage, site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <Fragment set:html={markup} />
    <script is:inline set:html={script}></script>
  </body>
</html>
